/// Casos semanais por município (consolidados e em nowcast) e clima
table fato_observado
	lineageTag: 333ea015-0b0b-4a12-b814-1578b96f92d6

	column geocode
		dataType: int64
		isHidden
		lineageTag: fa14ec7d-ca33-4d7b-8ea8-4b13239d880d
		summarizeBy: none
		sourceColumn: geocode

	column inicio_semana
		dataType: dateTime
