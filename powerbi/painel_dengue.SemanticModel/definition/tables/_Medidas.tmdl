	/// Cópia da mediana usada só para desenhar a faixa de 50% no gráfico
	measure 'Backtest mediana (faixa 50%)' = [Backtest mediana prevista]
		formatString: #,0
		displayFolder: 4 Backtest
		lineageTag: 7d89e316-e043-4f4c-a27f-5f867bdaef0b

	measure 'Texto cabeçalho' = "Fonte: InfoDengue e Mosqlimate  ·  dados até a " & MAX ( info_execucao[rotulo_ultima_semana] )
		displayFolder: 3 Textos
		lineageTag: dfc9d9c7-2251-4532-8bc8-c3cc6e4a8d8c

	measure 'Texto semanas previstas' =
			VAR i = CALCULATE ( MIN ( dim_semana[inicio_semana] ), REMOVEFILTERS ( dim_semana ), dim_semana[periodo] = "Previsão" )
			VAR f = CALCULATE ( MAX ( dim_semana[inicio_semana] ), REMOVEFILTERS ( dim_semana ), dim_semana[periodo] = "Previsão" )
			RETURN
			    LOOKUPVALUE ( dim_semana[rotulo_se], dim_semana[inicio_semana], i ) & " a "
			        & LOOKUPVALUE ( dim_semana[rotulo_se], dim_semana[inicio_semana], f )
		displayFolder: 3 Textos
		lineageTag: e16748ae-8b40-4399-8555-042470b072cd

	measure 'Texto IC 90%' = IF ( [_Uma previsão], FORMAT ( [Previsão IC 90% inferior], "#,0" ) & " – " & FORMAT ( [Previsão IC 90% superior], "#,0" ) )
		displayFolder: 3 Textos
		lineageTag: 18815596-2572-4d2d-ab13-0620801a1c69

	/// Cor de fundo da célula pela faixa de risco da probabilidade de alerta: baixo < 10%, moderado 10–25%, alto 25–50%, muito alto ≥ 50%
	measure 'Cor do risco (célula)' =
			VAR p = [Probabilidade de alerta]
			RETURN
			    SWITCH ( TRUE (),
			        ISBLANK ( p ), BLANK (),
			        p >= 0.5, "#EC9A9A",
			        p >= 0.25, "#F7C3A9",
			        p >= 0.1, "#FDE3A7",
			        "#E3F4E3" )
		displayFolder: 2 Previsão
		lineageTag: 8e472d3a-7bfd-4888-ae33-0c9efabd6c33

	/// Probabilidade de alerta na próxima semana com a faixa de risco por extenso
	measure 'Texto prob. de alerta próxima semana' =
			VAR p = [Probabilidade de alerta (próxima semana)]
			VAR faixa =
			    SWITCH ( TRUE (), p >= 0.5, "muito alto", p >= 0.25, "alto", p >= 0.1, "moderado", "baixo" )
			RETURN IF ( ISBLANK ( p ), "–", FORMAT ( p, "0%" ) & "  ·  " & faixa )
		displayFolder: 3 Textos
		lineageTag: d4eecb6e-6d0b-47ae-a55b-b3f2a75f1885

	/// Casos previstos na região daqui a 4 semanas (soma das medianas) em relação aos casos da última semana. Aproximação: quantis não se somam.
	measure 'Variação prevista na região (4 semanas)' =
			VAR atual = [Casos na última semana]
			VAR futuro = CALCULATE ( [Previsão total (soma das medianas)], fato_previsao[horizonte] = 4 )
			RETURN IF ( NOT ISBLANK ( futuro ) && atual > 0, DIVIDE ( futuro, atual ) - 1 )
		formatString: +0%;-0%;0%
		displayFolder: 2 Previsão
		lineageTag: f15d4fc8-55c4-4d7f-a551-ee84a602be92

	/// Variação prevista na região em 4 semanas com seta de direção, para o cartão da Visão geral
	measure 'Texto variação prevista (4 semanas)' =
			VAR v = [Variação prevista na região (4 semanas)]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( v ), "–",
			        ROUND ( v, 2 ) = 0, "= 0%",
			        v > 0, "▲ " & FORMAT ( v, "0%" ),
			        "▼ " & FORMAT ( -v, "0%" )
			    )
		displayFolder: 3 Textos
		lineageTag: 638e19c2-ee9e-4606-8196-12a5fe8ea66b

	/// Cor da barra do ranking pela faixa de risco da maior probabilidade de alerta em 4 semanas: baixo < 10% (verde), moderado 10–25% (amarelo), alto 25–50% (laranja), muito alto ≥ 50% (vermelho)
	measure 'Cor do risco (barra)' =
			VAR p = [Maior probabilidade de alerta (4 semanas)]
			RETURN
			    SWITCH ( TRUE (),
			        ISBLANK ( p ), BLANK (),
			        p >= 0.5, "#D03B3B",
			        p >= 0.25, "#EE8434",
			        p >= 0.1, "#F2C14E",
			        "#49BF95" )
		displayFolder: 2 Previsão
		lineageTag: 694d2aa4-7292-4c6c-841e-92019c5737bf

	/// Casos da última semana divididos pelo limiar de alerta do município (100% = no limiar)
	measure '% do limiar (última semana)' = DIVIDE ( [Casos na última semana], [Limiar de alerta (casos)] )
		formatString: 0%
		displayFolder: 1 Observado
		lineageTag: 827b9e51-d446-4fe7-9151-78393513b0cd

	/// % do limiar só para os 8 municípios mais próximos dele (os demais ficam em branco e saem do gráfico)
	measure '% do limiar (8 maiores)' =
			-- o visual agrupa também por dim_municipio[ordem] (coluna de classificação), por isso as duas colunas entram no ALL
			VAR atual = [% do limiar (última semana)]
			VAR acima =
			    COUNTROWS (
			        FILTER (
			            ALL ( dim_municipio[municipio], dim_municipio[ordem] ),
			            [% do limiar (última semana)] > atual
			        )
			    )
			RETURN IF ( NOT ISBLANK ( atual ) && acima < 8, atual )
		formatString: 0%
		displayFolder: 1 Observado
		lineageTag: 35cd5066-7ced-42f3-b10d-621ddd85a53b

	/// Limiar de alerta só quando está na escala do gráfico (até 2 vezes o maior valor das últimas 26 semanas e da previsão); assim ele não esmaga a curva
	measure 'Limiar no gráfico' =
			VAR lim = [Limiar de alerta (casos)]
			VAR semanas = CALCULATETABLE ( VALUES ( dim_semana[inicio_semana] ), REMOVEFILTERS ( dim_semana ), dim_semana[semanas_desde_ultima] >= -26 )
			VAR topo = MAXX ( semanas, MAX ( [Casos observados], [Previsão IC 90% superior] ) )
			RETURN IF ( NOT ISBLANK ( lim ) && lim <= 2 * topo, lim )
		formatString: #,0
		displayFolder: 2 Previsão
		lineageTag: 63840c04-0c16-46a5-a6de-5a39eb4cfd08

	/// Texto curto que aparece no gráfico da Previsão quando o limiar de alerta está acima da escala (e por isso não é desenhado)
	measure 'Aviso de limiar fora da escala' =
			VAR lim = [Limiar de alerta (casos)]
			VAR semanas = CALCULATETABLE ( VALUES ( dim_semana[inicio_semana] ), REMOVEFILTERS ( dim_semana ), dim_semana[semanas_desde_ultima] >= -26 )
			VAR topo = MAXX ( semanas, MAX ( [Casos observados], [Previsão IC 90% superior] ) )
			RETURN
			    IF (
			        NOT ISBLANK ( lim ) && lim > 2 * topo,
			        "Limiar de alerta (" & FORMAT ( lim, "#,0" ) & " casos) acima da escala",
			        " "
			    )
		displayFolder: 3 Textos
		lineageTag: f6ee1cd4-f02d-4cb0-9ce8-c971d9ce1baa

	/// Cor das barras do ranking 'Mais perto do limiar': cinza enquanto o município está longe do limiar; laranja a partir de 75% do limiar; vermelho no limiar ou acima. Destaca só o que pede atenção.
	measure 'Cor da proximidade (barra)' =
			VAR p = [% do limiar (8 maiores)]
			RETURN
			    SWITCH ( TRUE (),
			        ISBLANK ( p ), BLANK (),
			        p >= 1, "#D03B3B",
			        p >= 0.75, "#EE8434",
			        "#8A8F98" )
		displayFolder: 1 Observado
		lineageTag: f819a95b-bbbe-4cda-86d1-2e98c0aa2712

	/// Maior probabilidade de alerta em 4 semanas entre os municípios (cartão da Visão geral); o município vai no rótulo
	measure 'Texto maior risco (valor)' =
			VAR p = MAXX ( VALUES ( dim_municipio[municipio] ), [Maior probabilidade de alerta (4 semanas)] )
			RETURN IF ( ISBLANK ( p ), "–", FORMAT ( p, "0%" ) )
		displayFolder: 3 Textos
		lineageTag: 02eafa3f-47bd-4333-a457-8ede6f87f905

	/// Rótulo do cartão de maior risco: o município com a maior probabilidade de alerta em 4 semanas
	measure 'Texto maior risco (rótulo)' =
			VAR t =
			    TOPN ( 1,
			        ADDCOLUMNS ( VALUES ( dim_municipio[municipio] ), "@p", [Maior probabilidade de alerta (4 semanas)] ),
			        [@p], DESC )
			VAR m = MAXX ( t, dim_municipio[municipio] )
			RETURN IF ( ISBLANK ( MAXX ( t, [@p] ) ), "Maior risco", "Maior risco: " & m )
		displayFolder: 3 Textos
		lineageTag: 146732fb-9dd7-471c-ad7c-c2e52f85c384

	/// Probabilidade de alerta na próxima semana (cartão da Previsão); a faixa de risco vai no rótulo e na cor
	measure 'Texto prob. de alerta (valor)' =
			VAR p = [Probabilidade de alerta (próxima semana)]
			RETURN IF ( ISBLANK ( p ), "–", FORMAT ( p, "0%" ) )
		displayFolder: 3 Textos
		lineageTag: f495bd5f-a79b-4feb-9e84-8f7cc5581ed2

	/// Rótulo do cartão de probabilidade de alerta, com a faixa de risco por extenso
	measure 'Texto prob. de alerta (rótulo)' =
			VAR p = [Probabilidade de alerta (próxima semana)]
			VAR faixa =
			    SWITCH ( TRUE (), p >= 0.5, "muito alto", p >= 0.25, "alto", p >= 0.1, "moderado", "baixo" )
			RETURN IF ( ISBLANK ( p ), "Risco +1 semana", "Risco +1 semana: " & faixa )
		displayFolder: 3 Textos
		lineageTag: 4ad33da2-3f97-4a45-b220-e4be285e82e8

	/// Cor do número da probabilidade de alerta pela faixa de risco, em tons escuros o bastante para texto: verde < 10%, âmbar 10–25%, laranja 25–50%, vermelho ≥ 50%
	measure 'Cor do risco (texto)' =
			VAR p = [Probabilidade de alerta (próxima semana)]
			RETURN
			    SWITCH ( TRUE (),
			        ISBLANK ( p ), "#1F2328",
			        p >= 0.5, "#C62828",
			        p >= 0.25, "#D9622B",
			        p >= 0.1, "#B7791F",
			        "#2E8B57" )
		displayFolder: 2 Previsão
		lineageTag: bd23f190-aad0-46d8-a1e7-1655523cccf3

