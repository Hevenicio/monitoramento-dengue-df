/// Medidas do painel (ver powerbi/medidas.dax)
table _Medidas
	lineageTag: 265002e6-77f1-4984-87bb-c2f9a9900ea2

	measure 'Casos observados' = SUM ( fato_observado[casos_usados] )
		formatString: #,0
		displayFolder: 1 Observado
		lineageTag: ab1d6a15-aa8c-4157-a151-15ef386f1f73

	measure 'Linha observado consolidado' = SUM ( fato_observado[casos_consolidados] )
