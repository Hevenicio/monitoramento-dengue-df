		lineageTag: e00e8177-7a4c-4c37-8bb4-a79df8ae23d1

	measure 'Probabilidade de alerta (próxima semana)' = CALCULATE ( [Probabilidade de alerta], fato_previsao[horizonte] = 1 )
		formatString: 0%
		displayFolder: 2 Previsão
		lineageTag: 0bbdd98f-56a4-40a2-a9e6-681849be6dd9

	measure 'Maior probabilidade de alerta (4 semanas)' =
			IF (
			    HASONEVALUE ( dim_modelo[modelo] ),
			    CALCULATE ( MAX ( fato_previsao[prob_alerta] ), fato_previsao[horizonte] >= 1 )
			)
		formatString: 0%
		displayFolder: 2 Previsão
		lineageTag: eda8f112-1291-4011-a05c-faf76dbfaca2

	measure 'Municípios com alerta provável' =
			IF (
			    HASONEVALUE ( dim_modelo[modelo] ),
			    CALCULATE (
			        DISTINCTCOUNT ( fato_previsao[geocode] ),
			        fato_previsao[horizonte] >= 1,
			        fato_previsao[prob_alerta] >= 0.5
			    ) + 0
			)
		formatString: 0
		displayFolder: 2 Previsão
		lineageTag: dccba6e0-78a5-4d7c-996a-e4db20ef6023

	measure 'Previsão total (soma das medianas)' = IF ( HASONEVALUE ( dim_modelo[modelo] ), SUM ( fato_previsao[mediana] ) )
		formatString: #,0
		displayFolder: 2 Previsão
		lineageTag: bf65d3e8-9c21-4c30-a3d3-68208e5f602b

	measure 'Texto dados até' =
			"Dados até a " & MAX ( info_execucao[rotulo_ultima_semana] )
			    & " (semana iniciada em " & FORMAT ( MAX ( info_execucao[ultima_semana] ), "dd/mm/yyyy" ) & ")"
		displayFolder: 3 Textos
		lineageTag: 474f6ed8-2ec7-4586-8267-3e7817c801dd

	measure 'Texto próxima semana' =
			VAR m = CALCULATE ( [Previsão mediana], fato_previsao[horizonte] = 1 )
			VAR li = CALCULATE ( [Previsão IC 90% inferior], fato_previsao[horizonte] = 1 )
			VAR ls = CALCULATE ( [Previsão IC 90% superior], fato_previsao[horizonte] = 1 )
			RETURN
			    IF (
			        ISBLANK ( m ),
			        "Escolha um município e um modelo",
			        FORMAT ( m, "#,0" ) & " casos (IC 90%: " & FORMAT ( li, "#,0" ) & " a " & FORMAT ( ls, "#,0" ) & ")"
			    )
		displayFolder: 3 Textos
		lineageTag: bd55aebf-9667-4c9c-829f-7235a03f14b6

	measure 'Texto aviso de dados' =
			IF (
			    MAX ( info_execucao[fonte] ) = "sintetico",
			    "DADOS SINTÉTICOS: não representam a dengue real",
			    "Fonte: InfoDengue e Mosqlimate"
			)
		displayFolder: 3 Textos
		lineageTag: af8fc6b0-b5a9-4fff-a9d5-e782353956c2

	measure 'Backtest WIS (casos)' = AVERAGE ( fato_backtest[wis] )
