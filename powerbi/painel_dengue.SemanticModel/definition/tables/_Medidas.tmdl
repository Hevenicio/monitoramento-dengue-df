	/// Intervalo de 90% da próxima semana; a partir de mil casos vira "4,5 – 8,9 mil" para caber no cartão
	measure 'Texto IC 90% próxima semana' =
			VAR li = CALCULATE ( [Previsão IC 90% inferior], fato_previsao[horizonte] = 1 )
			VAR ls = CALCULATE ( [Previsão IC 90% superior], fato_previsao[horizonte] = 1 )
			RETURN
			    SWITCH ( TRUE (),
			        ISBLANK ( li ), "–",
			        ls >= 1000, FORMAT ( li / 1000, "#,0.0" ) & " – " & FORMAT ( ls / 1000, "#,0.0" ) & " mil",
			        FORMAT ( li, "#,0" ) & " – " & FORMAT ( ls, "#,0" ) )
		displayFolder: 3 Textos
		lineageTag: 7d3e748f-2a97-4177-9a32-ecf635b65860

	measure 'Texto maior risco' =
			VAR t =
			    TOPN ( 1,
			        ADDCOLUMNS ( VALUES ( dim_municipio[municipio] ), "@p", [Maior probabilidade de alerta (4 semanas)] ),
			        [@p], DESC )
			VAR p = MAXX ( t, [@p] )
			RETURN IF ( ISBLANK ( p ), "–", FORMAT ( p, "0%" ) & "  ·  " & MAXX ( t, dim_municipio[municipio] ) )
		displayFolder: 3 Textos
		lineageTag: 9f5e50f1-b086-4183-8c66-2f43856943d6

	measure 'Texto semana dos dados' = MAX ( info_execucao[rotulo_ultima_semana] )
		displayFolder: 3 Textos
		lineageTag: e6992d6d-d700-4f7c-aaf7-d2d1d4bef4fe

	measure 'Cobertura GBM quantílico' = CALCULATE ( [Cobertura observada], REMOVEFILTERS ( dim_modelo ), dim_modelo[modelo] = "gbm_quantilico" )
