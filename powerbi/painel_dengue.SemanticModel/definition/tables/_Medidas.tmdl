		displayFolder: 5 Cobertura
		lineageTag: 25ad1a85-20ee-4afb-a83f-8658b27642b2

	measure 'Cobertura Crescimento sazonal' = CALCULATE ( [Cobertura observada], REMOVEFILTERS ( dim_modelo ), dim_modelo[modelo] = "crescimento" )
